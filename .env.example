# Required. Use a long random value; never expose it to the browser.
OFFICE_ACCESS_KEY=

# Required. Provision Neon through the Vercel integration and use the injected connection string.
DATABASE_URL=

# Optional on Vercel when AI Gateway authenticates through Vercel OIDC.
# For local development, set an AI Gateway API key.
AI_GATEWAY_API_KEY=

# Current default verified against Vercel AI Gateway documentation.
AI_MODEL=openai/gpt-5.6-sol
